<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Project_Siti" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Warna utama Pine & Soul -->
        <item name="colorPrimary">@color/cone_brown</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <style name="Theme.Project_Siti" parent="Base.Theme.Project_Siti" />

    <!-- Font judul dan subjudul toolbar -->
    <style name="ToolbarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:fontFamily">@font/nunito_extrabold</item>
    </style>

    <style name="ToolbarSubtitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Subtitle">
        <item name="android:fontFamily">@font/dmsans_regular</item>
    </style>

    <!-- Font label Bottom Navigation -->
    <style name="BottomNavLabel" parent="TextAppearance.AppCompat.Caption">
        <item name="android:fontFamily">@font/nunito_bold</item>
    </style>
</resources>
